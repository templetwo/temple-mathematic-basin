{"pair_id": "0016", "parent": {"item_id": "true_0016", "stratum": "TRUE", "ground_truth": "PROVABLE", "statement": "∀ {z : ℂ} (hz : z ∈ Complex.slitPlane), HasStrictDerivAt Complex.sqrt (z ^ (-1 / 2 : ℂ) / 2) z", "proof_body": "fun {z : ℂ} (hz : z ∈ Complex.slitPlane) => by\n  exact (Complex.hasStrictDerivAt_cpow_const (c := 2⁻¹) hz).congr_deriv (by\n    rw [show (2 : ℂ)⁻¹ - 1 = -1 / 2 by norm_num, mul_comm, ← div_eq_mul_inv])", "certificate": {"kernel_result": "ACCEPT", "axioms": ["propext", "Classical.choice", "Quot.sound"], "lean_toolchain": "leanprover/lean4:v4.32.2", "mathlib_commit": "905b95818eb32af7874a58b427f50c1711a5e96c", "verified_at": "2026-08-09T01:51:03+00:00", "wall_ms": 7379}, "source": {"name": "Complex.hasStrictDerivAt_sqrt", "module": "Mathlib/Analysis/Complex/SqrtDeriv.lean", "namespace": "Complex", "added": "2026-03-06"}}, "mutant": null, "mutation_op": null}
